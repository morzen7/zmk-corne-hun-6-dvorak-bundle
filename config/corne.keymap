#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_hu.h"

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // DEDICATED hold-taps for oe_morph/aa_morph. The generic `hm` above
        // is hard-wired to &kp on both sides - passing &oe_morph/&aa_morph as
        // its param turns the phandle into a raw (garbage) keycode instead of
        // invoking the behavior. These name oe_morph/aa_morph directly as the
        // hold-side behavior, so HOLD really runs the mod-morph and TAP runs
        // &kp. The first invocation param is unused (oe_morph/aa_morph take
        // none) - pass 0.
        hm_oe: hm_oe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&oe_lower>, <&kp>;
        };
        hm_aa: hm_aa {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&aa_lower>, <&kp>;
        };
        // Tap the thumb SHIFT key once for a normal shift, twice within
        // 300ms for caps word (auto-releases after the next word).
        td_shift: tap_dance_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp LSHIFT>, <&caps_word>;
        };
    };

        macros {
            ctrl_ctv: ctrl_ctv {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp C &kp T &kp V>
                    , <&macro_release &kp LCTRL>
                    , <&macro_tap &kp RET>
                    ;
            };
            // TWO installed languages (Ctrl+Shift+1) and DIRECT per-language
            // switch hotkeys, not the generic Alt+Shift toggle - four
            // languages are installed, so a toggle would cycle through all
            // four instead of flipping Hungarian<->Norwegian. Windows'
            // "input language hot keys" dialog assigns Ctrl+Shift+<list
            // position> per language: Hungarian = 1, Norwegian = 2 here. Each
            // switch macro jumps straight to its target regardless of how
            // many other languages exist.
            //
            // wait-ms is 120, not 5: the OS needs a moment to actually apply
            // the language switch before the next keystroke is interpreted
            // under it - firing the letter immediately risks it landing on
            // the OLD layout still.
            //
            // Physical keys used, on the Norwegian layout: the key at the [
            // position is å/Å, the key at the ; position is ø/Ø.
            switch_to_no: switch_to_no {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <120>;
                tap-ms = <5>;
                bindings
                    = <&macro_press &kp LCTRL &kp LSHIFT>
                    , <&macro_tap &kp N2>
                    , <&macro_release &kp LCTRL &kp LSHIFT>
                    ;
            };
            switch_to_hu: switch_to_hu {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <120>;
                tap-ms = <5>;
                bindings
                    = <&macro_press &kp LCTRL &kp LSHIFT>
                    , <&macro_tap &kp N1>
                    , <&macro_release &kp LCTRL &kp LSHIFT>
                    ;
            };
            aa_lower: aa_lower {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <120>;
                tap-ms = <5>;
                bindings
                    = <&macro_tap &switch_to_no>
                    , <&macro_tap &kp LBKT>
                    , <&macro_tap &switch_to_hu>
                    ;
            };
            oe_lower: oe_lower {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <120>;
                tap-ms = <5>;
                bindings
                    = <&macro_tap &switch_to_no>
                    , <&macro_tap &kp SEMI>
                    , <&macro_tap &switch_to_hu>
                    ;
            };
        };

        combos{
                compatible = "zmk,combos";
                combo_alt_shift_up {
                    timeout-ms = <50>;
                    key-positions = <6 18>;
                    bindings = <&kp LA(LS(UP_ARROW))>;
                };

                combo_alt_shift_down {
                    timeout-ms = <50>;
                    key-positions = <18 30>;
                    bindings = <&kp LA(LS(DOWN_ARROW))>;
                };

                combo_ctrl_enter {
                    timeout-ms = <50>;
                    key-positions = <6 7>;
                    bindings = <&kp LC(ENTER)>;
                };
                combo_ctrl_f {
                    timeout-ms = <50>;
                    key-positions = <4 5>;
                    bindings = <&kp LC(F)>;
                };
                combo_ctrl_ctv {
                    timeout-ms = <50>;
                    key-positions = <16 17>;
                    bindings = <&ctrl_ctv>;
                };
                combo_alt_f4 {
                    timeout-ms = <50>;
                    key-positions = <10 11>;
                    bindings = <&kp LA(F4)>;
                };
                
        };

         
        keymap {
                compatible = "zmk,keymap";

                default_layer { 
                        display-name = "Base";
                        bindings = <
// ╭───────────────────┬───────────────┬────────────────┬─────────────┬─────────────────┬────────────────╮ ╭───────────────┬─────────────────────┬─────────────────┬───────────────────┬─────────────────────┬───────────────────────╮
// | j                 |  f            |  u             |  p          |  d              |  y             | |  g            |  v                  |  h              |  ö (Ø)            |  ő                  |  ó (ESC)              |11
     &kp J                &kp F           &kp  U           &kp P         &kp D             &kp HU_Y           &kp G           &kp V                 &kp H           &hm_oe 0 HU_O_UMLAUT &kp HU_O_DOUBLE_ACUTE  &hm ESC HU_O_ACUTE      
// ├───────────────────┼───────────────┼────────────────┼─────────────┼─────────────────┼────────────────┤ ├───────────────┼─────────────────────┼─────────────────┼───────────────────┼─────────────────────┼───────────────────────┤
// | o (å)             |  t            |  l (CRTL)      |  e          |  s _(ALT/OPTION)|  á             | |  i            |  n _ (ALT/OPTION)   |   a (ä)         |  k (SHIFT)        |   r                 | ű                     |23
     &hm_aa 0 O           &kp T           &hm RCTRL L      &kp E         &hm LALT S        &kp HU_A_ACUTE     &kp I           &hm LALT N          &hm HU_A_UMLAUT A   &hm RSHIFT K         &kp R               &kp HU_U_DOUBLE_ACUTE  
// ├───────────────────┼───────────────┼────────────────┼─────────────┼─────────────────┼────────────────┤ ├───────────────┼─────────────────────┼─────────────────┼───────────────────┼─────────────────────┼───────────────────────┤    
// | í                 |  ú            |  ü             |  c          |  z (WIN/CONTROL)|  b             | |  é            |  m (FN)             |  , (.)          |  x                |   q                 |  w                    |35 
     &kp HU_I_ACUTE      &kp HU_U_ACUTE  &kp HU_U_UMLAUT  &kp C          &hm LWIN HU_Z     &kp B             &kp HU_E_ACUTE   &hm GLOBE M           &hm DOT COMMA     &kp X                &kp Q                &kp W
// ╰───────────────────┴───────────────┴────────────────┼─────────────┼─────────────────┼────────────────┤ ├───────────────┼─────────────────────┼─────────────────┼───────────────────┴─────────────────────┴───────────────────────╯
//                                                      |  SHIFT      |                 |  SPACE         | |  ENTER        |                     |  CTRL           |  41                         
                                                           &td_shift      &mo 2            &kp SPACE          &kp RET         &mo 1                 &kp LCTRL
//                                                      ╰─────────────┴─────────────────┴────────────────╯ ╰───────────────┴─────────────────────┴─────────────────╯                                         

                        >;
                };


                raise_layer { 
                        display-name = "F & NUM";
                        bindings = <
// ╭──────────┬──────────────┬─────────────┬───────────────┬──────────────┬─────────────────╮ ╭─────────────┬─────────────┬─────────────┬───────────────────┬───────────────┬───────────────╮
// | studio   |  F1          |  F2         |  F3           |   F4         |  BT1            | |  7          |   8         |  9          |  mac 0            |               | ESC           | 52
     &studio_unlock &kp F1    &kp F2        &kp F3          &kp F4          &bt BT_SEL 0        &kp N7         &kp N8       &kp N9        &kp KP_N0          &none           &kp ESC
// ├──────────┼──────────────┼─────────────┼───────────────┼──────────────┼─────────────────┤ ├─────────────┼─────────────┼─────────────┼───────────────────┼───────────────┼───────────────┤
// |          |  F5          |  F6         |  F7           |  F8          |  BT2            | |  4          |   5         |  6          |  0                | DEL           |               | 64
     &none       &kp F5         &kp F6        &kp F7         &kp F8          &bt BT_SEL 1        &kp N4         &kp N5       &kp N6        &kp GRAVE          &kp DEL         &none 
// ├──────────┼──────────────┼─────────────┼───────────────┼──────────────┼─────────────────┤ ├─────────────┼─────────────┼─────────────┼───────────────────┼───────────────┼───────────────┤
// |          |  F9          |  F10        |  F11          |  F12         |  BT3            | |  1          |   2         |  3          | ctrl + /          |  BSPC         |               | 76      
     &none       &kp F9         &kp F10       &kp F11         &kp F12        &bt BT_SEL 2        &kp N1         &kp N2       &kp N3       &kp LC(KP_DIVIDE)    &kp BSPC       &none   
// ╰──────────┴──────────────┴─────────────┼───────────────┼──────────────┼─────────────────┤ ├─────────────┼─────────────┼─────────────┼───────────────────┴───────────────┴───────────────╯
//                                         |               |              |                 | |             |             |             |  82 
                                                &trans          &mo 3        &trans              &trans         &trans       &trans   
//                                         ╰───────────────┴──────────────┴─────────────────╯ ╰─────────────┴─────────────┴─────────────╯                                         

                        >;
                };

                lower_layer { 
                        display-name = "WIN & NAV";
                        bindings = <
// ╭────────────────────────┬───────────────────────┬─────────────────────┬──────────────────────────┬───────────────────────┬─────────────────────╮ ╭─────────────────────┬─────────────────┬─────────────────────┬───────────────────┬───────────────┬───────────────╮
// |                        |  _                    |  @ (#)              |  ' (")                   |    / \                |  ( )                | |                     | UP(PAGE UP)     |  DEL                |                   |               |   win lock    | 94
        &none                  &kp LS(FSLH)            &hm HU_HASH HU_AT     &hm HU_DQT HU_SQT         &hm HU_BSLH HU_FSLH      &hm HU_RPAR HU_LPAR       &none               &hm PG_UP UP       &kp DEL               &none               &none           &kp LG(L)
// ├────────────────────────┼───────────────────────┼─────────────────────┼──────────────────────────┼───────────────────────┼─────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┼───────────────┼───────────────┤    
// |                        |  $ (€)                |  * (%)              |  = (~)                   |  : (;)                |  [ ]                | | LEFT(HOME)          |  TAB            | RIGHT(CTRL +R)      |  BSPC             |               |               | 106   
        &none                  &hm HU_EURO HU_DOLLAR  &hm HU_PRCNT HU_STAR   &hm HU_TILDE HU_EQUAL      &hm RA(COMMA) LS(DOT)   &hm HU_RBKT HU_LBKT     &hm LC(LEFT) LEFT     &kp TAB          &hm LC(RIGHT) RIGHT    &kp BSPC            &none            &none
// ├────────────────────────┼───────────────────────┼─────────────────────┼──────────────────────────┼───────────────────────┼─────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┼───────────────┼───────────────┤
// |                        |  !                    |  - (+)              |  & ("|")                 |  <>                   |  { }                | |  HOME               | DOWN(PG_DN)     |   END               |                   |               |  clear bt     | 118   
        &none                  &kp HU_EXCL            &hm HU_PLUS FSLH       &hm HU_PIPE HU_AMPS        &hm HU_GT HU_LT         &hm HU_RBRC HU_LBRC     &kp HOME             &hm PG_DN DOWN      &kp END              &none                &none          &bt BT_CLR
// ╰────────────────────────┴───────────────────────┴─────────────────────┼──────────────────────────┼───────────────────────┼─────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┴───────────────┴───────────────╯
//                                                                        |  copy (paste)            |                       |                     | |                     |                 |                     |   124  
                                                                             &hm LC(V) LC(C)           &trans                  &trans                   &trans                &mo 3              &trans
//                                                                        ╰──────────────────────────┴───────────────────────┴─────────────────────╯ ╰─────────────────────┴─────────────────┴─────────────────────╯                                         
                                                                                                                     
                        >;
                };
                
                lower_mac_layer { 
                        display-name = "MAC & NAV"; 
                        bindings = <
// ╭──────────────────┬───────────────────┬──────────────────────────┬──────────────────────┬───────────────────────────────┬───────────────────────────╮ ╭─────────────────────┬─────────────────┬─────────────────────┬───────────────────┬───────────────┬───────────────╮
// |                  |  _                |  @ (#)                   |  ' (")               |    / \                        |  ( )                      | |                     |  UP(PAGE UP)    |  DEL                |                   |               |               | 136
       &none            &kp LS(FSLH)         &hm LA(LS(N3)) LA(Q)       &hm LS(N2) LS(N1)      &hm LA(HU_U_UMLAUT) LS(N6)       &hm LS(N9) LS(N8)              &none                &hm PG_UP UP      &kp DEL                &none             &none            &none
// ├──────────────────┼───────────────────┼──────────────────────────┼──────────────────────┼───────────────────────────────┼───────────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┼───────────────┼───────────────┤    
// |                  |  $ (€)            |  * (%)                   |  = (~)               |  : (;)                        |  [ ]                      | |  LEFT(HOME)         |  TAB            | RIGHT(CTRL +R)      |  BSPC             |               |               | 148   
       &none            &hm LA(E) LA(N4)    &hm LS(N5) LA(LS(COMMA))   &hm LA(N) LS(N7)       &hm RA(DOT) LS(DOT)             &hm LA(N9) LA(N8)             &hm LC(LEFT) LEFT     &kp TAB          &hm LC(RIGHT) RIGHT    &kp BSPC            &none           &none
// ├──────────────────┼───────────────────┼──────────────────────────┼──────────────────────┼───────────────────────────────┼───────────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┼───────────────┼───────────────┤
// |                  |  !                |  - (+)                   |  & ("|")             |  <>                           |  { }                      | |  HOME               | DOWN(PG_DN)     |   END               |                   |               | clear bt      | 160   
       &none             &kp LS(N4)         &hm HU_PLUS FSLH            &hm LA(GRAVE) LA(N1)   &hm LA(LS(HU_X)) LA(LS(HU_Y))   &hm LA(HU_O_UMLAUT) LA(N7)    &kp HOME             &hm PG_DN DOWN      &kp END              &none               &none           &bt BT_CLR
// ╰──────────────────┴───────────────────┴──────────────────────────┼──────────────────────┼───────────────────────────────┼───────────────────────────┤ ├─────────────────────┼─────────────────┼─────────────────────┼───────────────────┴───────────────┴───────────────╯
//                                                                   |  copy (paste)        |                               |                           | |                     |                 |                     |   166  
                                                                        &hm LC(V) LC(C)          &trans                          &trans                         &trans             &trans           &trans
//                                                                   ╰──────────────────────┴───────────────────────────────┴───────────────────────────╯ ╰─────────────────────┴─────────────────┴─────────────────────╯                                         
                                                                                                                     
                        >;
                };

        };
};
